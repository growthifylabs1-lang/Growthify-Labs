# Firebase web configuration. These values are public Firebase client config,
# but should still be supplied through the deployment environment.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Public social links. Use digits only for WhatsApp.
VITE_WHATSAPP_NUMBER=your_whatsapp_number
VITE_INSTAGRAM_USERNAME=your_instagram_username

